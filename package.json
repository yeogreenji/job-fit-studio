{
  "name": "job-fit-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "JobFit Studio — 채용 공고 한 편과 내 이력서로 적합도·갭 분석, 공고 맞춤 리라이트, 1분 자기소개·역질문, 90초 모의면접 피드백, 지원 현황·처우 협상까지 만드는 실전형 AI 커리어 코치",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json",
    "typecheck:app": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "test:e2e": "python3 scripts/verify.py",
    "shots": "python3 scripts/shots.py"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
