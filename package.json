{
  "name": "job-fit-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "JobFit Studio — 여러 채용 공고를 한 번에 모아 지원 요건·제출서류·원문 지원 링크를 정리하고, 내 이력서로 지원 문구·자소서 초안을 만들어 직접 지원까지 이어 주는 지원 허브",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json",
    "typecheck:app": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "test:e2e": "python3 scripts/verify.py",
    "shots": "python3 scripts/shots.py",
    "test:pdf": "node scripts/test-pdf.mjs",
    "make:pdf": "python3 scripts/make-pdf-fixture.py"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
